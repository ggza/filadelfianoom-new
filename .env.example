APP_NAME="Filadelfia Noom"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=filadelfia
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=cohost.host-in-europe.com
MAIL_PORT=465
MAIL_USERNAME=noreply@filadelfianoom.ro
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@filadelfianoom.ro"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Filadelfia
ASSET_VERSION=1
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@filadelfianoom.ro
# üresen hagyva a seed véletlen jelszót generál és kiírja
ADMIN_PASSWORD=

# az admin ennyi perc tétlenség után automatikusan kilép
ADMIN_IDLE_MINUTES=30

# Cloudflare Turnstile (üresen hagyva ki van kapcsolva)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin belépés: e-mailben küldött biztonsági kód
ADMIN_MFA=true
ADMIN_MFA_TRUST_DAYS=30
